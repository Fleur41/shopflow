# Copy to .env for local overrides. NEVER commit a real .env file.
# Every value below is a placeholder. Real secrets for staging and production
# come from the deployment platform's secrets manager, never from files.

# --- Local docker compose -------------------------------------------------
POSTGRES_PASSWORD=shopflow

# --- Django (required outside development) --------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Production must use a non-default, hard-to-guess admin path.
DJANGO_ADMIN_URL=admin/
DJANGO_SECURE_SSL_REDIRECT=true

# --- Data stores ----------------------------------------------------------
DATABASE_URL=postgres://shopflow:shopflow@localhost:5432/shopflow
REDIS_URL=redis://localhost:6379/0

# --- Logging & monitoring -------------------------------------------------
LOG_JSON=false
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
APP_RELEASE=

# --- Frontend -------------------------------------------------------------
# Where the Next.js server forwards /api/* (server-side only, never exposed).
API_INTERNAL_URL=http://localhost:8000

# --- Added in later phases (placeholders) ---------------------------------
# EMAIL_URL=smtp://user:password@smtp.example.com:587
# PAYMENT_PROVIDER_CREDENTIALS=
