# Copy to .env for local overrides. NEVER commit a real .env file.
# Every value below is a placeholder. Real secrets for staging and production
# come from the deployment platform's secrets manager, never from files.

# --- Local docker compose -------------------------------------------------
POSTGRES_PASSWORD=shopflow

# --- Django (required outside development) --------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Production must use a non-default, hard-to-guess admin path.
DJANGO_ADMIN_URL=admin/
DJANGO_SECURE_SSL_REDIRECT=true

# --- Data stores ----------------------------------------------------------
DATABASE_URL=postgres://shopflow_app:shopflow_app@localhost:5432/shopflow
REDIS_URL=redis://localhost:6379/0

# --- Logging & monitoring -------------------------------------------------
LOG_JSON=false
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
APP_RELEASE=

# --- Frontend -------------------------------------------------------------
# Where the Next.js server forwards /api/* (server-side only, never exposed).
API_INTERNAL_URL=http://localhost:8000

# --- Added in later phases (placeholders) ---------------------------------
# EMAIL_URL=smtp://user:password@smtp.example.com:587
# PAYMENT_PROVIDER_CREDENTIALS=

# --- API authentication ---------------------------------------------------
# kid=secret pairs; secrets >= 32 chars. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEYS=k1=change-me-to-a-long-random-value-of-48-characters
JWT_ACTIVE_KEY_ID=k1
# Reverse proxies in front of the API (for client-IP detection). 0 locally.
TRUSTED_PROXY_COUNT=0

# --- Database roles -------------------------------------------------------
# The app connects as a restricted role (DATABASE_URL above). Migrations run
# as the schema owner via MIGRATION_DATABASE_URL in the deploy job, and grant
# the app role row access only (no UPDATE/DELETE on append-only tables).
MIGRATION_DATABASE_URL=postgres://shopflow:shopflow@localhost:5432/shopflow
DATABASE_APP_ROLE=shopflow_app
POSTGRES_APP_PASSWORD=shopflow_app
